{
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "node_modules/.bin/oxfmt",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["!deno", "..."]
    },
    "TSX": {
      "language_servers": ["!deno", "..."]
    },
    "JavaScript": {
      "language_servers": ["!deno", "..."]
    },
    "JSX": {
      "language_servers": ["!deno", "..."]
    }
  }
}
